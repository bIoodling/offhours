# Host secrets only. Server members need no software and no credentials.
DISCORD_TOKEN=
OFFHOURS_DB_PATH=offhours.sqlite3
# Optional old server ID, used once to migrate the existing Offhours preset.
GUILD_ID=0
# OWNER_ID is no longer used; permissions use each server's administrators.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional executable overrides. Blank uses packaged host executables.
FFMPEG_PATH=
DENO_PATH=
# Optional supported TikTok provider adapter; no browser scraping.
TIKTOK_PROVIDER_URL=
TIKTOK_PROVIDER_TOKEN=

# Optional shared API spending and quota ceilings.
OPENAI_ALLOWED_MODELS=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_DAILY_TOKEN_LIMIT=50000
OPENAI_GLOBAL_DAILY_TOKEN_LIMIT=200000
YOUTUBE_DAILY_QUOTA_BUDGET=9000
